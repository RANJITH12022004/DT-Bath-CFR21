# Tap Density - copy to .env and adjust
# On Windows use local paths; on Pi use /media/usb_internal etc.

APP_ROOT=.
STORAGE_DIR=./storage
REPORTS_DIR=./reports
EXPORT_USB_PATH=./export

# MCU serial (for tap density / simulated data)
ESP_PORT=/dev/serial0
ESP_BAUD=9600

# R307 fingerprint sensor (GPIO12/13 -> /dev/ttyAMA5)
BIOMETRIC_PORT=/dev/ttyAMA5
BIOMETRIC_BAUD=57600
BIOMETRIC_ENROLL_TIMEOUT_SEC=12
BIOMETRIC_LOGIN_TIMEOUT_SEC=10

# Printers
A4_PORT=/dev/ttyAMA4
A4_BAUD=9600
THERMAL_PORT=/dev/ttyAMA3
THERMAL_BAUD=9600

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
